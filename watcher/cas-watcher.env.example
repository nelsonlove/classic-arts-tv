# Copy to /etc/cas-watcher.env. Every line is optional; the defaults are in cas_watcher.py.
CAS_STREAM_URL=https://classicarts.akamaized.net/hls/live/1024257/CAS/master_360p30.m3u8
CAS_INTERVAL=5
CAS_PORT=8080
# Set when the service is mounted under a path by a reverse proxy, e.g. /classicarts
CAS_PATH_PREFIX=
# Optional: correct the OCR with a Claude model that also sees the frame (Anthropic Messages API format).
# Leave CAS_LLM_URL empty to turn it off. The key file is read once at start; keep it mode 600.
CAS_LLM_URL=
CAS_LLM_KEY_FILE=/etc/cas-watcher.key
CAS_LLM_MODEL=claude-haiku-5-5
CAS_LLM_EFFORT=low
# When the host reaches the endpoint only through a proxy (e.g. tailscaled in userspace mode), set it here; the stream never uses it.
# HTTPS_PROXY=http://127.0.0.1:1055
